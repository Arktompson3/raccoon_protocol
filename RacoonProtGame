<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Raccoon Protocol: 2D Survival Shooter</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
      -webkit-touch-callout: none;
    }
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #090b10;
      color: #e2e8f0;
      font-family: 'Inter', sans-serif;
      touch-action: none;
    }
    .mono {
      font-family: 'JetBrains Mono', monospace;
    }
    .ecg-pulse {
      animation: pulseGlow 1.6s infinite ease-in-out;
    }
    @keyframes pulseGlow {
      0%, 100% { opacity: 0.85; }
      50% { opacity: 1; filter: drop-shadow(0 0 6px currentColor); }
    }
    .crt-overlay {
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.22) 50%);
      background-size: 100% 4px;
      pointer-events: none;
    }
  </style>
</head>
<body class="relative w-full h-full flex flex-col justify-between overflow-hidden bg-slate-950">

  <!-- Игровой холст -->
  <canvas id="gameCanvas" class="absolute inset-0 w-full h-full block z-0"></canvas>
  <div class="crt-overlay absolute inset-0 z-10"></div>

  <!-- Верхний интерфейс (HUD) -->
  <header class="relative z-20 flex flex-wrap items-center justify-between gap-2 px-3 py-2 bg-slate-950/85 border-b border-slate-800/80 backdrop-blur-md">
    <!-- Статус здоровья в стиле ЭКГ RE -->
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-2 bg-slate-900/90 border border-slate-700/80 rounded-lg px-2.5 py-1">
        <svg id="ecgIcon" class="w-6 h-5 text-emerald-400 ecg-pulse" viewBox="0 0 64 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="2,12 16,12 21,4 27,21 33,8 38,16 42,12 62,12" />
        </svg>
        <div>
          <div class="flex items-center gap-1.5">
            <span id="healthStatusText" class="mono text-xs font-bold tracking-wider text-emerald-400">FINE</span>
            <span id="hpValueText" class="mono text-xs text-slate-400">100%</span>
          </div>
          <div class="w-24 sm:w-28 h-1.5 bg-slate-800 rounded-full overflow-hidden mt-0.5">
            <div id="hpBar" class="h-full bg-emerald-500 transition-all duration-150" style="width: 100%;"></div>
          </div>
        </div>
      </div>

      <!-- Волна и счёт -->
      <div class="flex items-center gap-2 bg-slate-900/90 border border-slate-700/80 rounded-lg px-2.5 py-1">
        <div class="text-xs">
          <span class="text-slate-400">ВОЛНА</span>
          <span id="waveText" class="mono font-bold text-amber-400 ml-1">1</span>
        </div>
        <div class="h-3 w-px bg-slate-700"></div>
        <div class="text-xs">
          <span class="text-slate-400">СЧЁТ</span>
          <span id="scoreText" class="mono font-bold text-white ml-1">0</span>
        </div>
        <div class="hidden sm:block h-3 w-px bg-slate-700"></div>
        <div class="hidden sm:block text-xs">
          <span class="text-slate-400">РЕКОРД</span>
          <span id="bestScoreText" class="mono font-bold text-cyan-400 ml-1">0</span>
        </div>
      </div>
    </div>

    <!-- Кнопки управления и оружия -->
    <div class="flex items-center gap-1.5">
      <!-- Выбор оружия -->
      <div class="flex items-center bg-slate-900/90 border border-slate-700/80 rounded-lg p-0.5">
        <button id="btnWep1" type="button" class="px-2 py-1 rounded text-xs mono font-semibold bg-blue-600 text-white transition" title="Пистолет Matilda (Клавиша 1)">
          1:Matilda <span class="opacity-80">∞</span>
        </button>
        <button id="btnWep2" type="button" class="px-2 py-1 rounded text-xs mono font-semibold text-slate-300 hover:text-white transition" title="Дробовик W-870 (Клавиша 2)">
          2:SG <span id="sgAmmoText" class="text-amber-400">12</span>
        </button>
        <button id="btnWep3" type="button" class="px-2 py-1 rounded text-xs mono font-semibold text-slate-300 hover:text-white transition" title="Магнум Lightning Hawk (Клавиша 3)">
          3:Mag <span id="magAmmoText" class="text-rose-400">5</span>
        </button>
      </div>

      <!-- Звук -->
      <button id="btnMute" type="button" class="p-1.5 rounded-lg bg-slate-900/90 border border-slate-700/80 text-slate-300 hover:text-white hover:border-slate-500 transition" title="Вкл/Выкл звук">
        <span id="muteIcon" class="text-xs mono font-bold px-1">ЗВУК:ВКЛ</span>
      </button>

      <!-- Пауза -->
      <button id="btnPause" type="button" class="p-1.5 rounded-lg bg-slate-900/90 border border-slate-700/80 text-slate-300 hover:text-white hover:border-slate-500 transition text-xs mono font-bold px-2">
        ПАУЗА
      </button>

      <!-- Инструкция для Telegram -->
      <button id="btnTgHelp" type="button" class="p-1.5 rounded-lg bg-sky-600/90 hover:bg-sky-500 border border-sky-400/50 text-white transition text-xs font-semibold px-2.5">
        TG Гайд
      </button>
    </div>
  </header>

  <!-- Баннер предупреждения о Боссе Тиране -->
  <div id="bossBanner" class="hidden relative z-20 mx-auto mt-2 px-4 py-1.5 rounded-full bg-red-950/90 border border-red-500/80 text-red-200 text-xs sm:text-sm font-bold tracking-wider uppercase shadow-lg">
    ⚠ ВНИМАНИЕ: ПРИБЛИЖАЕТСЯ ТИРАН T-103 (MR. X)! ⚠
  </div>

  <!-- Нижний интерфейс и сенсорное управление для смартфона / Telegram -->
  <footer class="relative z-20 w-full pointer-events-none flex flex-col justify-end p-3 sm:p-4 mt-auto">
    <!-- Экранные джойстики и быстрые кнопки -->
    <div class="flex items-end justify-between w-full">
      <!-- Левый джойстик (ходьба) -->
      <div id="leftJoystickZone" class="pointer-events-auto relative w-28 h-28 sm:w-32 sm:h-32 rounded-full bg-slate-900/45 border-2 border-slate-600/50 backdrop-blur-sm flex items-center justify-center touch-none">
        <div id="leftStickKnob" class="w-11 h-11 rounded-full bg-blue-500/70 border-2 border-blue-300 shadow-md transition-transform duration-75"></div>
        <span class="absolute -top-5 text-[10px] mono uppercase tracking-wider text-slate-400">Движение</span>
      </div>

      <!-- Центральная панель действий (Перекат, Фонарь, Оружие) -->
      <div class="pointer-events-auto flex flex-col items-center gap-2 mb-1">
        <div class="flex items-center gap-2">
          <button id="btnDash" type="button" class="px-3 py-2 rounded-xl bg-amber-600/85 hover:bg-amber-500 active:scale-95 border border-amber-400/70 text-white text-xs font-bold mono shadow-lg transition">
            РЫВОК (SPACE)
          </button>
          <button id="btnFlashlight" type="button" class="px-3 py-2 rounded-xl bg-slate-800/85 hover:bg-slate-700 active:scale-95 border border-slate-600 text-slate-200 text-xs font-bold mono shadow-lg transition">
            ФОНАРЬ (F)
          </button>
        </div>
        <div class="text-[11px] text-slate-400 hidden md:block bg-slate-950/75 px-3 py-1 rounded-full border border-slate-800">
          ПК: <span class="text-slate-200 font-semibold">WASD</span> — ход, <span class="text-slate-200 font-semibold">Мышь / ЛКМ</span> — прицел и огонь, <span class="text-slate-200 font-semibold">1-3 / Q</span> — оружие, <span class="text-slate-200 font-semibold">Space</span> — рывок
        </div>
      </div>

      <!-- Правый джойстик (прицел и стрельба) -->
      <div id="rightJoystickZone" class="pointer-events-auto relative w-28 h-28 sm:w-32 sm:h-32 rounded-full bg-slate-900/45 border-2 border-red-600/50 backdrop-blur-sm flex items-center justify-center touch-none">
        <div id="rightStickKnob" class="w-11 h-11 rounded-full bg-red-500/70 border-2 border-red-300 shadow-md transition-transform duration-75"></div>
        <span class="absolute -top-5 text-[10px] mono uppercase tracking-wider text-red-400">Огонь / Прицел</span>
      </div>
    </div>
  </footer>

  <!-- Стартовое / Пауза / Game Over модальное окно -->
  <div id="menuModal" class="fixed inset-0 z-30 flex items-center justify-center p-4 bg-slate-950/85 backdrop-blur-md">
    <div class="w-full max-w-md bg-slate-900 border border-slate-700 rounded-2xl p-6 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
        <div>
          <span class="text-[11px] mono uppercase tracking-widest text-blue-400 font-semibold">R.P.D. Special Division</span>
          <h1 id="modalTitle" class="text-2xl font-extrabold text-white tracking-tight">RACCOON PROTOCOL</h1>
        </div>
        <div class="w-11 h-11 rounded-xl bg-blue-950 border border-blue-500/50 flex items-center justify-center text-blue-300 font-extrabold mono text-sm">
          R.P.D.
        </div>
      </div>

      <p id="modalSubtitle" class="text-sm text-slate-300 leading-relaxed mb-4">
        Вы — агент в синей форме R.P.D. в стиле Леона Кеннеди. Удерживайте периметр полицейского участка, отстреливайте волны зомби, церберов и останавливайте мутировавших Тиранов T-103!
      </p>

      <!-- Итоговая статистика (показывается при гибели или паузе) -->
      <div id="statsSummaryBox" class="hidden grid grid-cols-3 gap-2 mb-4 bg-slate-950/80 p-3 rounded-xl border border-slate-800 text-center">
        <div>
          <div class="text-[10px] text-slate-400 uppercase mono">Счёт</div>
          <div id="finalScoreVal" class="text-lg font-bold text-white mono">0</div>
        </div>
        <div>
          <div class="text-[10px] text-slate-400 uppercase mono">Волна</div>
          <div id="finalWaveVal" class="text-lg font-bold text-amber-400 mono">1</div>
        </div>
        <div>
          <div class="text-[10px] text-slate-400 uppercase mono">Убито</div>
          <div id="finalKillsVal" class="text-lg font-bold text-emerald-400 mono">0</div>
        </div>
      </div>

      <!-- Справка по предметам и врагам -->
      <div class="bg-slate-950/60 border border-slate-800/90 rounded-xl p-3.5 mb-5 space-y-2 text-xs text-slate-300">
        <div class="flex items-center justify-between">
          <span class="font-semibold text-emerald-400">🌿 Зелёная / Красная трава</span>
          <span class="text-slate-400">+35% / +80% ОЗ</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="font-semibold text-amber-400">📦 Патроны (Дробь / Магнум)</span>
          <span class="text-slate-400">W-870 и Lightning Hawk</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="font-semibold text-red-400">🧥 Тиран T-103 (Mr. X)</span>
          <span class="text-slate-400">Босс в плаще, таранная атака</span>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-2.5">
        <button id="btnStartGame" type="button" class="flex-1 py-3 px-4 rounded-xl bg-blue-600 hover:bg-blue-500 active:scale-98 text-white font-bold text-sm tracking-wide shadow-lg shadow-blue-600/30 transition">
          НАЧАТЬ ЗАЧИСТКУ
        </button>
        <button id="btnResumeGame" type="button" class="hidden flex-1 py-3 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 active:scale-98 text-white font-bold text-sm tracking-wide shadow-lg shadow-emerald-600/30 transition">
          ПРОДОЛЖИТЬ
        </button>
      </div>
    </div>
  </div>


  <script>
    (function () {
      // --- Интеграция с Telegram WebApp (если открыто внутри Telegram) ---
      const tg = (window.Telegram && window.Telegram.WebApp) ? window.Telegram.WebApp : null;
      if (tg) {
        try {
          tg.ready();
          tg.expand();
        } catch (e) {}
      }

      function triggerHaptic(type) {
        if (!tg || !tg.HapticFeedback) return;
        try {
          if (type === 'light') tg.HapticFeedback.impactOccurred('light');
          else if (type === 'medium') tg.HapticFeedback.impactOccurred('medium');
          else if (type === 'heavy') tg.HapticFeedback.impactOccurred('heavy');
          else if (type === 'damage') tg.HapticFeedback.notificationOccurred('error');
        } catch (e) {}
      }

      // --- Синтезатор звука (Web Audio API без внешних файлов) ---
      let audioCtx = null;
      let soundMuted = false;

      function initAudio() {
        if (!audioCtx) {
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          if (AudioContextClass) {
            audioCtx = new AudioContextClass();
          }
        }
        if (audioCtx && audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
      }

      function playSound(effect) {
        if (soundMuted || !audioCtx) return;
        const now = audioCtx.currentTime;

        if (effect === 'pistol') {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(260, now);
          osc.frequency.exponentialRampToValueAtTime(55, now + 0.09);
          gain.gain.setValueAtTime(0.18, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(now);
          osc.stop(now + 0.09);
        } else if (effect === 'shotgun') {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'square';
          osc.frequency.setValueAtTime(150, now);
          osc.frequency.exponentialRampToValueAtTime(32, now + 0.22);
          gain.gain.setValueAtTime(0.28, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(now);
          osc.stop(now + 0.22);
        } else if (effect === 'magnum') {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(420, now);
          osc.frequency.exponentialRampToValueAtTime(40, now + 0.28);
          gain.gain.setValueAtTime(0.34, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.28);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(now);
          osc.stop(now + 0.28);
        } else if (effect === 'pickup') {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(520, now);
          osc.frequency.setValueAtTime(780, now + 0.06);
          gain.gain.setValueAtTime(0.14, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.16);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(now);
          osc.stop(now + 0.16);
        } else if (effect === 'roar') {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(95, now);
          osc.frequency.linearRampToValueAtTime(48, now + 0.55);
          gain.gain.setValueAtTime(0.25, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.55);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(now);
          osc.stop(now + 0.55);
        } else if (effect === 'hurt') {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(140, now);
          osc.frequency.exponentialRampToValueAtTime(60, now + 0.15);
          gain.gain.setValueAtTime(0.22, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.15);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(now);
          osc.stop(now + 0.15);
        }
      }

      // --- DOM Элементы ---
      const canvas = document.getElementById('gameCanvas');
      const ctx = canvas.getContext('2d');

      const ecgIcon = document.getElementById('ecgIcon');
      const healthStatusText = document.getElementById('healthStatusText');
      const hpValueText = document.getElementById('hpValueText');
      const hpBar = document.getElementById('hpBar');
      const waveText = document.getElementById('waveText');
      const scoreText = document.getElementById('scoreText');
      const bestScoreText = document.getElementById('bestScoreText');
      const sgAmmoText = document.getElementById('sgAmmoText');
      const magAmmoText = document.getElementById('magAmmoText');
      const bossBanner = document.getElementById('bossBanner');

      const btnWep1 = document.getElementById('btnWep1');
      const btnWep2 = document.getElementById('btnWep2');
      const btnWep3 = document.getElementById('btnWep3');
      const btnMute = document.getElementById('btnMute');
      const muteIcon = document.getElementById('muteIcon');
      const btnPause = document.getElementById('btnPause');
      const btnTgHelp = document.getElementById('btnTgHelp');
      const btnDash = document.getElementById('btnDash');
      const btnFlashlight = document.getElementById('btnFlashlight');

      const menuModal = document.getElementById('menuModal');
      const modalTitle = document.getElementById('modalTitle');
      const modalSubtitle = document.getElementById('modalSubtitle');
      const statsSummaryBox = document.getElementById('statsSummaryBox');
      const finalScoreVal = document.getElementById('finalScoreVal');
      const finalWaveVal = document.getElementById('finalWaveVal');
      const finalKillsVal = document.getElementById('finalKillsVal');
      const btnStartGame = document.getElementById('btnStartGame');
      const btnResumeGame = document.getElementById('btnResumeGame');

      const tgGuideModal = document.getElementById('tgGuideModal');
      const btnCloseTgGuide = document.getElementById('btnCloseTgGuide');
      const btnOkTgGuide = document.getElementById('btnOkTgGuide');

      const leftJoystickZone = document.getElementById('leftJoystickZone');
      const leftStickKnob = document.getElementById('leftStickKnob');
      const rightJoystickZone = document.getElementById('rightJoystickZone');
      const rightStickKnob = document.getElementById('rightStickKnob');

      // --- Рекорд в localStorage ---
      let bestScore = 0;
      try {
        const saved = localStorage.getItem('raccoon_protocol_best');
        if (saved) bestScore = parseInt(saved, 10) || 0;
      } catch (e) {}
      bestScoreText.textContent = String(bestScore);

      function saveBestScore(newScore) {
        if (newScore > bestScore) {
          bestScore = newScore;
          bestScoreText.textContent = String(bestScore);
          try {
            localStorage.setItem('raccoon_protocol_best', String(bestScore));
          } catch (e) {}
        }
      }

      // --- Параметры мира и состояния игры ---
      const WORLD_W = 1600;
      const WORLD_H = 1200;

      let gameState = 'menu'; // 'menu' | 'playing' | 'paused' | 'gameover'
      let animFrameId = null;
      let lastTime = 0;

      let score = 0;
      let wave = 1;
      let kills = 0;
      let flashlightOn = true;
      let screenShake = 0;

      // Оружие в арсенале Леона
      const WEAPONS = {
        1: {
          id: 1,
          name: 'Matilda 9mm',
          fireRate: 0.17,
          damage: 28,
          speed: 780,
          pellets: 1,
          spread: 0.04,
          color: '#fde047',
          sound: 'pistol',
          knockback: 18
        },
        2: {
          id: 2,
          name: 'W-870 Shotgun',
          fireRate: 0.62,
          damage: 24,
          speed: 700,
          pellets: 6,
          spread: 0.28,
          color: '#fb923c',
          sound: 'shotgun',
          knockback: 45
        },
        3: {
          id: 3,
          name: 'Lightning Hawk',
          fireRate: 0.48,
          damage: 135,
          speed: 980,
          pellets: 1,
          spread: 0.01,
          color: '#38bdf8',
          sound: 'magnum',
          knockback: 85,
          pierce: 2
        }
      };

      const player = {
        x: WORLD_W / 2,
        y: WORLD_H / 2,
        radius: 18,
        speed: 235,
        hp: 100,
        maxHp: 100,
        angle: 0,
        weapon: 1,
        ammo: { 2: 12, 3: 5 },
        fireCooldown: 0,
        dashCooldown: 0,
        dashTime: 0,
        dashVx: 0,
        dashVy: 0,
        invulnTime: 0,
        muzzleFlash: 0
      };

      // Колонны и баррикады полицейского участка R.P.D.
      const obstacles = [
        { x: 450, y: 360, w: 90, h: 90 },
        { x: 1060, y: 360, w: 90, h: 90 },
        { x: 450, y: 750, w: 90, h: 90 },
        { x: 1060, y: 750, w: 90, h: 90 },
        { x: 755, y: 240, w: 90, h: 60 },
        { x: 755, y: 900, w: 90, h: 60 }
      ];

      let bullets = [];
      let enemies = [];
      let items = [];
      let particles = [];
      let floatingTexts = [];
      let bloodDecals = [];

      let waveEnemiesRemaining = 0;
      let spawnTimer = 0;

      // Управление (Клавиатура + Мышь + 2 Сенсорных джойстика)
      const keys = {};
      const mouse = { x: 0, y: 0, down: false, active: false };
      const leftStick = { active: false, id: null, startX: 0, startY: 0, dx: 0, dy: 0 };
      const rightStick = { active: false, id: null, startX: 0, startY: 0, dx: 0, dy: 0 };

      function resizeCanvas() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      }
      window.addEventListener('resize', resizeCanvas);
      resizeCanvas();

      // --- Инициализация и сброс игры ---
      function resetGame() {
        score = 0;
        wave = 1;
        kills = 0;
        screenShake = 0;

        player.x = WORLD_W / 2;
        player.y = WORLD_H / 2;
        player.hp = 100;
        player.angle = 0;
        player.weapon = 1;
        player.ammo = { 2: 12, 3: 5 };
        player.fireCooldown = 0;
        player.dashCooldown = 0;
        player.dashTime = 0;
        player.invulnTime = 0;
        player.muzzleFlash = 0;

        bullets = [];
        enemies = [];
        items = [];
        particles = [];
        floatingTexts = [];
        bloodDecals = [];

        startWave(1);
        updateHUD();
        updateWeaponButtons();
      }

      function startWave(waveNum) {
        wave = waveNum;
        waveEnemiesRemaining = 6 + waveNum * 4;
        spawnTimer = 0.5;
        bossBanner.classList.add('hidden');

        // Начиная со 2-й волны или каждые 2 волны появляется Босс Тиран T-103 (Mr. X)
        if (waveNum >= 2) {
          spawnEnemy('tyrant');
          bossBanner.classList.remove('hidden');
          playSound('roar');
          triggerHaptic('heavy');
        }

        floatingTexts.push({
          x: player.x,
          y: player.y - 40,
          text: 'ВОЛНА ' + waveNum,
          color: '#fbbf24',
          life: 2.0
        });
        updateHUD();
      }

      function spawnEnemy(forcedType) {
        // Выбор точки спавна по краям зала R.P.D.
        let ex = 0;
        let ey = 0;
        const side = Math.floor(Math.random() * 4);
        if (side === 0) {
          ex = 60 + Math.random() * (WORLD_W - 120);
          ey = 60;
        } else if (side === 1) {
          ex = 60 + Math.random() * (WORLD_W - 120);
          ey = WORLD_H - 60;
        } else if (side === 2) {
          ex = 60;
          ey = 60 + Math.random() * (WORLD_H - 120);
        } else {
          ex = WORLD_W - 60;
          ey = 60 + Math.random() * (WORLD_H - 120);
        }

        let type = forcedType;
        if (!type) {
          const r = Math.random();
          if (wave >= 3 && r < 0.14) type = 'crimson';
          else if (wave >= 2 && r < 0.34) type = 'dog';
          else type = 'zombie';
        }

        if (type === 'tyrant') {
          const bossHp = 420 + wave * 140;
          enemies.push({
            type: 'tyrant',
            name: 'ТИРАН T-103',
            x: ex,
            y: ey,
            radius: 28,
            hp: bossHp,
            maxHp: bossHp,
            speed: 108 + Math.min(40, wave * 4),
            damage: 28,
            scoreValue: 250,
            chargeCooldown: 3.5,
            chargeTime: 0,
            angle: 0
          });
        } else if (type === 'dog') {
          const hp = 40 + wave * 6;
          enemies.push({
            type: 'dog',
            name: 'Цербер',
            x: ex,
            y: ey,
            radius: 13,
            hp: hp,
            maxHp: hp,
            speed: 175 + Math.random() * 25,
            damage: 14,
            scoreValue: 35,
            angle: 0
          });
        } else if (type === 'crimson') {
          const hp = 85 + wave * 12;
          enemies.push({
            type: 'crimson',
            name: 'Криmson Head',
            x: ex,
            y: ey,
            radius: 17,
            hp: hp,
            maxHp: hp,
            speed: 145 + Math.random() * 20,
            damage: 20,
            scoreValue: 50,
            angle: 0
          });
        } else {
          const hp = 60 + wave * 10;
          enemies.push({
            type: 'zombie',
            name: 'Зомби',
            x: ex,
            y: ey,
            radius: 16,
            hp: hp,
            maxHp: hp,
            speed: 78 + Math.random() * 28,
            damage: 16,
            scoreValue: 20,
            angle: 0
          });
        }
      }

      function spawnLoot(x, y, isBoss) {
        const roll = Math.random();
        if (isBoss) {
          items.push({ x: x - 18, y: y, type: 'red_herb', radius: 14, life: 25 });
          items.push({ x: x + 18, y: y, type: 'magnum_ammo', radius: 14, life: 25 });
          return;
        }
        if (roll < 0.14) {
          items.push({ x, y, type: 'green_herb', radius: 13, life: 20 });
        } else if (roll < 0.30) {
          items.push({ x, y, type: 'shotgun_ammo', radius: 13, life: 20 });
        } else if (roll < 0.38) {
          items.push({ x, y, type: 'magnum_ammo', radius: 13, life: 20 });
        }
      }

      // --- Обновление HUD ---
      function updateHUD() {
        const hpPercent = Math.max(0, Math.round((player.hp / player.maxHp) * 100));
        hpValueText.textContent = hpPercent + '%';
        hpBar.style.width = hpPercent + '%';

        if (hpPercent > 65) {
          healthStatusText.textContent = 'FINE';
          healthStatusText.className = 'mono text-xs font-bold tracking-wider text-emerald-400';
          ecgIcon.className = 'w-6 h-5 text-emerald-400 ecg-pulse';
          hpBar.className = 'h-full bg-emerald-500 transition-all duration-150';
        } else if (hpPercent > 30) {
          healthStatusText.textContent = 'CAUTION';
          healthStatusText.className = 'mono text-xs font-bold tracking-wider text-amber-400';
          ecgIcon.className = 'w-6 h-5 text-amber-400 ecg-pulse';
          hpBar.className = 'h-full bg-amber-500 transition-all duration-150';
        } else {
          healthStatusText.textContent = 'DANGER';
          healthStatusText.className = 'mono text-xs font-bold tracking-wider text-red-500';
          ecgIcon.className = 'w-6 h-5 text-red-500 ecg-pulse';
          hpBar.className = 'h-full bg-red-600 transition-all duration-150';
        }

        waveText.textContent = String(wave);
        scoreText.textContent = String(score);
        sgAmmoText.textContent = String(player.ammo[2]);
        magAmmoText.textContent = String(player.ammo[3]);
      }

      function selectWeapon(id) {
        if (!WEAPONS[id]) return;
        player.weapon = id;
        updateWeaponButtons();
      }

      function updateWeaponButtons() {
        const activeClass = 'px-2 py-1 rounded text-xs mono font-semibold bg-blue-600 text-white transition';
        const idleClass = 'px-2 py-1 rounded text-xs mono font-semibold text-slate-300 hover:text-white transition';
        btnWep1.className = player.weapon === 1 ? activeClass : idleClass;
        btnWep2.className = player.weapon === 2 ? activeClass : idleClass;
        btnWep3.className = player.weapon === 3 ? activeClass : idleClass;
      }

      // --- Рывок / Уклонение Леона ---
      function performDash() {
        if (gameState !== 'playing' || player.dashCooldown > 0) return;
        let dx = 0;
        let dy = 0;
        if (keys['KeyW'] || keys['ArrowUp']) dy -= 1;
        if (keys['KeyS'] || keys['ArrowDown']) dy += 1;
        if (keys['KeyA'] || keys['ArrowLeft']) dx -= 1;
        if (keys['KeyD'] || keys['ArrowRight']) dx += 1;

        if (leftStick.active && (Math.abs(leftStick.dx) > 0.1 || Math.abs(leftStick.dy) > 0.1)) {
          dx = leftStick.dx;
          dy = leftStick.dy;
        }
        if (dx === 0 && dy === 0) {
          dx = Math.cos(player.angle);
          dy = Math.sin(player.angle);
        } else {
          const len = Math.hypot(dx, dy);
          dx /= len;
          dy /= len;
        }

        player.dashVx = dx * 560;
        player.dashVy = dy * 560;
        player.dashTime = 0.18;
        player.dashCooldown = 1.1;
        player.invulnTime = 0.25;
        triggerHaptic('light');
      }

      // --- Стрельба ---
      function fireWeapon() {
        if (player.fireCooldown > 0) return;

        let wepId = player.weapon;
        if (wepId !== 1 && player.ammo[wepId] <= 0) {
          // Автопереключение на пистолет Matilda при пустом магазине
          selectWeapon(1);
          wepId = 1;
        }

        const wep = WEAPONS[wepId];
        if (wepId !== 1) {
          player.ammo[wepId] -= 1;
        }

        player.fireCooldown = wep.fireRate;
        player.muzzleFlash = 0.06;
        playSound(wep.sound);
        triggerHaptic(wepId === 3 ? 'medium' : 'light');
        screenShake = Math.max(screenShake, wepId === 1 ? 2.5 : 6.5);

        const gunTipX = player.x + Math.cos(player.angle) * 24;
        const gunTipY = player.y + Math.sin(player.angle) * 24;

        for (let i = 0; i < wep.pellets; i++) {
          const spreadAngle = player.angle + (Math.random() - 0.5) * wep.spread;
          bullets.push({
            x: gunTipX,
            y: gunTipY,
            vx: Math.cos(spreadAngle) * wep.speed,
            vy: Math.sin(spreadAngle) * wep.speed,
            damage: wep.damage,
            color: wep.color,
            knockback: wep.knockback,
            pierce: wep.pierce || 1,
            life: 1.1
          });
        }

        updateHUD();
      }

      // --- Столкновение круга с прямоугольным препятствием ---
      function resolveCircleRect(entity, rect) {
        const closestX = Math.max(rect.x, Math.min(entity.x, rect.x + rect.w));
        const closestY = Math.max(rect.y, Math.min(entity.y, rect.y + rect.h));
        const dx = entity.x - closestX;
        const dy = entity.y - closestY;
        const distSq = dx * dx + dy * dy;
        if (distSq < entity.radius * entity.radius) {
          const dist = Math.sqrt(distSq) || 0.001;
          const overlap = entity.radius - dist;
          entity.x += (dx / dist) * overlap;
          entity.y += (dy / dist) * overlap;
        }
      }

      // --- Основной цикл обновления ---
      function update(dt) {
        if (screenShake > 0) {
          screenShake = Math.max(0, screenShake - dt * 25);
        }

        // Таймеры игрока
        if (player.fireCooldown > 0) player.fireCooldown -= dt;
        if (player.dashCooldown > 0) player.dashCooldown -= dt;
        if (player.invulnTime > 0) player.invulnTime -= dt;
        if (player.muzzleFlash > 0) player.muzzleFlash -= dt;

        // Движение игрока
        if (player.dashTime > 0) {
          player.dashTime -= dt;
          player.x += player.dashVx * dt;
          player.y += player.dashVy * dt;
        } else {
          let moveX = 0;
          let moveY = 0;
          if (keys['KeyW'] || keys['ArrowUp']) moveY -= 1;
          if (keys['KeyS'] || keys['ArrowDown']) moveY += 1;
          if (keys['KeyA'] || keys['ArrowLeft']) moveX -= 1;
          if (keys['KeyD'] || keys['ArrowRight']) moveX += 1;

          if (leftStick.active) {
            moveX = leftStick.dx;
            moveY = leftStick.dy;
          } else if (moveX !== 0 || moveY !== 0) {
            const len = Math.hypot(moveX, moveY);
            moveX /= len;
            moveY /= len;
          }

          player.x += moveX * player.speed * dt;
          player.y += moveY * player.speed * dt;
        }

        // Ограничение стенами зала R.P.D.
        player.x = Math.max(40 + player.radius, Math.min(WORLD_W - 40 - player.radius, player.x));
        player.y = Math.max(40 + player.radius, Math.min(WORLD_H - 40 - player.radius, player.y));

        for (let i = 0; i < obstacles.length; i++) {
          resolveCircleRect(player, obstacles[i]);
        }

        // Прицеливание и стрельба
        const camX = player.x - canvas.width / 2;
        const camY = player.y - canvas.height / 2;

        if (rightStick.active && (Math.abs(rightStick.dx) > 0.12 || Math.abs(rightStick.dy) > 0.12)) {
          player.angle = Math.atan2(rightStick.dy, rightStick.dx);
          fireWeapon();
        } else if (mouse.active) {
          const worldMouseX = mouse.x + camX;
          const worldMouseY = mouse.y + camY;
          player.angle = Math.atan2(worldMouseY - player.y, worldMouseX - player.x);
          if (mouse.down) {
            fireWeapon();
          }
        }

        // Спавн врагов текущей волны
        if (waveEnemiesRemaining > 0) {
          spawnTimer -= dt;
          if (spawnTimer <= 0) {
            spawnEnemy();
            waveEnemiesRemaining -= 1;
            spawnTimer = Math.max(0.45, 1.5 - wave * 0.08);
          }
        } else if (enemies.length === 0) {
          startWave(wave + 1);
        }

        // Обновление пуль
        for (let i = bullets.length - 1; i >= 0; i--) {
          const b = bullets[i];
          b.x += b.vx * dt;
          b.y += b.vy * dt;
          b.life -= dt;

          // Проверка стен и колонн
          let hitWall = (b.x < 40 || b.x > WORLD_W - 40 || b.y < 40 || b.y > WORLD_H - 40);
          if (!hitWall) {
            for (let k = 0; k < obstacles.length; k++) {
              const ob = obstacles[k];
              if (b.x >= ob.x && b.x <= ob.x + ob.w && b.y >= ob.y && b.y <= ob.y + ob.h) {
                hitWall = true;
                break;
              }
            }
          }

          if (hitWall || b.life <= 0) {
            bullets.splice(i, 1);
            continue;
          }

          // Попадание по зомби и Тиранам
          for (let j = enemies.length - 1; j >= 0; j--) {
            const e = enemies[j];
            const dist = Math.hypot(b.x - e.x, b.y - e.y);
            if (dist < e.radius + 4) {
              e.hp -= b.damage;
              const pushAngle = Math.atan2(b.vy, b.vx);
              const kb = e.type === 'tyrant' ? b.knockback * 0.22 : b.knockback;
              e.x += Math.cos(pushAngle) * kb;
              e.y += Math.sin(pushAngle) * kb;

              // Брызги крови
              for (let p = 0; p < 5; p++) {
                const a = pushAngle + (Math.random() - 0.5) * 0.9;
                const spd = 60 + Math.random() * 140;
                particles.push({
                  x: e.x,
                  y: e.y,
                  vx: Math.cos(a) * spd,
                  vy: Math.sin(a) * spd,
                  color: '#dc2626',
                  size: 2.5 + Math.random() * 2.5,
                  life: 0.35
                });
              }

              if (e.hp <= 0) {
                score += e.scoreValue;
                kills += 1;
                saveBestScore(score);
                bloodDecals.push({ x: e.x, y: e.y, radius: e.radius * (0.9 + Math.random() * 0.4) });
                if (bloodDecals.length > 70) bloodDecals.shift();

                spawnLoot(e.x, e.y, e.type === 'tyrant');
                if (e.type === 'tyrant') {
                  bossBanner.classList.add('hidden');
                  floatingTexts.push({
                    x: e.x,
                    y: e.y - 20,
                    text: 'ТИРАН ПОВЕРЖЕН! +250',
                    color: '#f87171',
                    life: 1.8
                  });
                }
                enemies.splice(j, 1);
                updateHUD();
              }

              b.pierce -= 1;
              if (b.pierce <= 0) {
                bullets.splice(i, 1);
                break;
              }
            }
          }
        }

        // Обновление врагов
        for (let i = 0; i < enemies.length; i++) {
          const e = enemies[i];
          const dx = player.x - e.x;
          const dy = player.y - e.y;
          const dist = Math.hypot(dx, dy) || 1;
          e.angle = Math.atan2(dy, dx);

          let currentSpeed = e.speed;
          if (e.type === 'tyrant') {
            e.chargeCooldown -= dt;
            if (e.chargeCooldown <= 0) {
              e.chargeTime = 0.65;
              e.chargeCooldown = 4.2;
              playSound('roar');
            }
            if (e.chargeTime > 0) {
              e.chargeTime -= dt;
              currentSpeed = e.speed * 2.15;
            }
          }

          e.x += (dx / dist) * currentSpeed * dt;
          e.y += (dy / dist) * currentSpeed * dt;

          for (let k = 0; k < obstacles.length; k++) {
            resolveCircleRect(e, obstacles[k]);
          }

          // Отталкивание врагов друг от друга
          for (let j = i + 1; j < enemies.length; j++) {
            const other = enemies[j];
            const odx = e.x - other.x;
            const ody = e.y - other.y;
            const odist = Math.hypot(odx, ody) || 0.1;
            const minDist = e.radius + other.radius;
            if (odist < minDist) {
              const overlap = (minDist - odist) * 0.5;
              e.x += (odx / odist) * overlap;
              e.y += (ody / odist) * overlap;
              other.x -= (odx / odist) * overlap;
              other.y -= (ody / odist) * overlap;
            }
          }

          // Урон по Леону
          const playerDist = Math.hypot(player.x - e.x, player.y - e.y);
          if (playerDist < player.radius + e.radius && player.invulnTime <= 0) {
            player.hp = Math.max(0, player.hp - e.damage);
            player.invulnTime = 0.65;
            screenShake = 10;
            playSound('hurt');
            triggerHaptic('damage');
            updateHUD();

            floatingTexts.push({
              x: player.x,
              y: player.y - 25,
              text: '-' + e.damage + ' HP',
              color: '#ef4444',
              life: 0.9
            });

            if (player.hp <= 0) {
              triggerGameOver();
              return;
            }
          }
        }

        // Сбор предметов (трава и патроны)
        for (let i = items.length - 1; i >= 0; i--) {
          const it = items[i];
          it.life -= dt;
          if (it.life <= 0) {
            items.splice(i, 1);
            continue;
          }

          const dist = Math.hypot(player.x - it.x, player.y - it.y);
          if (dist < player.radius + it.radius + 6) {
            playSound('pickup');
            triggerHaptic('light');
            if (it.type === 'green_herb') {
              player.hp = Math.min(player.maxHp, player.hp + 35);
              floatingTexts.push({ x: it.x, y: it.y, text: 'Зелёная трава +35%', color: '#4ade80', life: 1.2 });
            } else if (it.type === 'red_herb') {
              player.hp = Math.min(player.maxHp, player.hp + 80);
              floatingTexts.push({ x: it.x, y: it.y, text: 'Смесь трав +80%', color: '#f43f5e', life: 1.4 });
            } else if (it.type === 'shotgun_ammo') {
              player.ammo[2] += 8;
              floatingTexts.push({ x: it.x, y: it.y, text: '+8 Патронов Дробовика', color: '#fb923c', life: 1.2 });
            } else if (it.type === 'magnum_ammo') {
              player.ammo[3] += 4;
              floatingTexts.push({ x: it.x, y: it.y, text: '+4 Патрона Магнума', color: '#38bdf8', life: 1.2 });
            }
            items.splice(i, 1);
            updateHUD();
          }
        }

        // Частицы
        for (let i = particles.length - 1; i >= 0; i--) {
          const p = particles[i];
          p.x += p.vx * dt;
          p.y += p.vy * dt;
          p.life -= dt;
          if (p.life <= 0) particles.splice(i, 1);
        }

        // Всплывающий текст
        for (let i = floatingTexts.length - 1; i >= 0; i--) {
          const ft = floatingTexts[i];
          ft.y -= 28 * dt;
          ft.life -= dt;
          if (ft.life <= 0) floatingTexts.splice(i, 1);
        }
      }

      // --- Отрисовка мира, Леона, зомби, Тиранов и луча фонаря ---
      function render() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        const shakeX = screenShake > 0 ? (Math.random() - 0.5) * screenShake : 0;
        const shakeY = screenShake > 0 ? (Math.random() - 0.5) * screenShake : 0;
        const camX = player.x - canvas.width / 2 + shakeX;
        const camY = player.y - canvas.height / 2 + shakeY;

        ctx.save();
        ctx.translate(-camX, -camY);

        // Пол полицейского участка R.P.D. (шахматная плитка холла)
        ctx.fillStyle = '#111622';
        ctx.fillRect(0, 0, WORLD_W, WORLD_H);

        const tileSize = 80;
        for (let x = 40; x < WORLD_W - 40; x += tileSize) {
          for (let y = 40; y < WORLD_H - 40; y += tileSize) {
            const isAlt = ((x / tileSize) + (y / tileSize)) % 2 === 0;
            ctx.fillStyle = isAlt ? '#161d2b' : '#121824';
            ctx.fillRect(x, y, tileSize, tileSize);
          }
        }

        // Красная ковровая дорожка в центре холла R.P.D.
        ctx.fillStyle = '#3b1219';
        ctx.fillRect(WORLD_W / 2 - 110, 80, 220, WORLD_H - 160);
        ctx.strokeStyle = '#7f1d1d';
        ctx.lineWidth = 3;
        ctx.strokeRect(WORLD_W / 2 - 110, 80, 220, WORLD_H - 160);

        // Периметр стен
        ctx.strokeStyle = '#334155';
        ctx.lineWidth = 8;
        ctx.strokeRect(40, 40, WORLD_W - 80, WORLD_H - 80);

        // Следы крови на полу
        for (let i = 0; i < bloodDecals.length; i++) {
          const d = bloodDecals[i];
          ctx.fillStyle = 'rgba(127, 29, 29, 0.55)';
          ctx.beginPath();
          ctx.arc(d.x, d.y, d.radius, 0, Math.PI * 2);
          ctx.fill();
        }

        // Предметы (Травы и патроны)
        for (let i = 0; i < items.length; i++) {
          const it = items[i];
          ctx.save();
          ctx.translate(it.x, it.y);
          if (it.type === 'green_herb' || it.type === 'red_herb') {
            ctx.fillStyle = it.type === 'green_herb' ? '#22c55e' : '#ef4444';
            ctx.beginPath();
            ctx.arc(0, 0, 11, 0, Math.PI * 2);
            ctx.fill();
            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = 1.5;
            ctx.stroke();
          } else {
            ctx.fillStyle = it.type === 'shotgun_ammo' ? '#ea580c' : '#0284c7';
            ctx.fillRect(-10, -8, 20, 16);
            ctx.strokeStyle = '#fde047';
            ctx.lineWidth = 1.5;
            ctx.strokeRect(-10, -8, 20, 16);
          }
          ctx.restore();
        }

        // Колонны R.P.D.
        for (let i = 0; i < obstacles.length; i++) {
          const ob = obstacles[i];
          ctx.fillStyle = '#1e293b';
          ctx.fillRect(ob.x, ob.y, ob.w, ob.h);
          ctx.strokeStyle = '#475569';
          ctx.lineWidth = 3;
          ctx.strokeRect(ob.x, ob.y, ob.w, ob.h);
        }

        // Отрисовка врагов (Зомби, Церберы, Кримсон Хеды и Тиран Mr. X)
        for (let i = 0; i < enemies.length; i++) {
          const e = enemies[i];
          ctx.save();
          ctx.translate(e.x, e.y);
          ctx.rotate(e.angle);

          if (e.type === 'tyrant') {
            // Тиран T-103 в тёмном плаще
            ctx.fillStyle = '#18181b';
            ctx.beginPath();
            ctx.arc(0, 0, e.radius, 0, Math.PI * 2);
            ctx.fill();
            ctx.strokeStyle = e.chargeTime > 0 ? '#ef4444' : '#52525b';
            ctx.lineWidth = 3;
            ctx.stroke();

            // Мощные плечи и руки Тирана
            ctx.fillStyle = '#27272a';
            ctx.fillRect(6, -24, 18, 10);
            ctx.fillRect(6, 14, 18, 10);

            // Серо-пепельная голова и фетровая шляпа Mr. X
            ctx.fillStyle = '#9ca3af';
            ctx.beginPath();
            ctx.arc(0, 0, 13, 0, Math.PI * 2);
            ctx.fill();
            ctx.fillStyle = '#27272a';
            ctx.fillRect(-8, -11, 14, 22);
          } else if (e.type === 'dog') {
            // Зомби-пес Цербер
            ctx.fillStyle = '#451a03';
            ctx.fillRect(-14, -8, 28, 16);
            ctx.fillStyle = '#dc2626';
            ctx.fillRect(6, -5, 8, 4);
          } else {
            // Обычный зомби или Crimson Head
            ctx.fillStyle = e.type === 'crimson' ? '#7f1d1d' : '#365314';
            ctx.beginPath();
            ctx.arc(0, 0, e.radius, 0, Math.PI * 2);
            ctx.fill();
            ctx.strokeStyle = '#1a2e05';
            ctx.lineWidth = 2;
            ctx.stroke();

            // Вытянутые вперёд руки зомби
            ctx.fillStyle = e.type === 'crimson' ? '#991b1b' : '#4d7c0f';
            ctx.fillRect(4, -14, 16, 6);
            ctx.fillRect(4, 8, 16, 6);
          }
          ctx.restore();

          // Полоска здоровья для Босса Тирана или раненых врагов
          if (e.type === 'tyrant' || e.hp < e.maxHp) {
            const barW = e.type === 'tyrant' ? 54 : 30;
            const barH = e.type === 'tyrant' ? 6 : 4;
            ctx.fillStyle = 'rgba(0,0,0,0.7)';
            ctx.fillRect(e.x - barW / 2, e.y - e.radius - 14, barW, barH);
            ctx.fillStyle = e.type === 'tyrant' ? '#ef4444' : '#22c55e';
            ctx.fillRect(e.x - barW / 2, e.y - e.radius - 14, barW * Math.max(0, e.hp / e.maxHp), barH);
          }
        }

        // Отрисовка героя (Леон С. Кеннеди в форме R.P.D. и со светлой чёлкой)
        ctx.save();
        ctx.translate(player.x, player.y);
        ctx.rotate(player.angle);

        // Лазерный целеуказатель в духе Resident Evil 4
        ctx.strokeStyle = 'rgba(239, 68, 68, 0.45)';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(20, 0);
        ctx.lineTo(240, 0);
        ctx.stroke();

        // Торс в синей броне R.P.D.
        ctx.fillStyle = player.invulnTime > 0 ? '#93c5fd' : '#1d4ed8';
        ctx.beginPath();
        ctx.arc(0, 0, player.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#1e3a8a';
        ctx.lineWidth = 2.5;
        ctx.stroke();

        // Разгрузочный жилет и руки с оружием
        ctx.fillStyle = '#0f172a';
        ctx.fillRect(-8, -15, 14, 30);
        ctx.fillStyle = '#334155';
        ctx.fillRect(10, -4, 16, 8);

        // Вспышка выстрела
        if (player.muzzleFlash > 0) {
          ctx.fillStyle = '#fde047';
          ctx.beginPath();
          ctx.arc(30, 0, 8 + Math.random() * 5, 0, Math.PI * 2);
          ctx.fill();
        }

        // Голова и фирменная светло-русая причёска Леона с чёлкой
        ctx.fillStyle = '#fde68a';
        ctx.beginPath();
        ctx.arc(0, 0, 10.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#ca8a04';
        ctx.beginPath();
        ctx.arc(-2, 0, 10.5, Math.PI * 0.55, Math.PI * 1.45);
        ctx.fill();

        ctx.restore();

        // Пули
        for (let i = 0; i < bullets.length; i++) {
          const b = bullets[i];
          ctx.fillStyle = b.color;
          ctx.beginPath();
          ctx.arc(b.x, b.y, 3.5, 0, Math.PI * 2);
          ctx.fill();
        }

        // Частицы крови и искр
        for (let i = 0; i < particles.length; i++) {
          const p = particles[i];
          ctx.fillStyle = p.color;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fill();
        }

        // Атмосферное освещение (луч тактического фонаря в темноте)
        if (flashlightOn) {
          ctx.save();
          ctx.translate(player.x, player.y);
          ctx.rotate(player.angle);
          const grad = ctx.createRadialGradient(0, 0, 25, 160, 0, 340);
          grad.addColorStop(0, 'rgba(255, 250, 220, 0.18)');
          grad.addColorStop(1, 'rgba(255, 250, 220, 0)');
          ctx.fillStyle = grad;
          ctx.beginPath();
          ctx.moveTo(0, 0);
          ctx.arc(0, 0, 360, -0.48, 0.48);
          ctx.closePath();
          ctx.fill();
          ctx.restore();
        }

        // Всплывающие надписи
        ctx.font = 'bold 13px "JetBrains Mono", monospace';
        ctx.textAlign = 'center';
        for (let i = 0; i < floatingTexts.length; i++) {
          const ft = floatingTexts[i];
          ctx.fillStyle = ft.color;
          ctx.fillText(ft.text, ft.x, ft.y);
        }

        ctx.restore();

        // Виньетка хоррор-атмосферы по краям экрана
        const vig = ctx.createRadialGradient(
          canvas.width / 2,
          canvas.height / 2,
          Math.min(canvas.width, canvas.height) * 0.28,
          canvas.width / 2,
          canvas.height / 2,
          Math.max(canvas.width, canvas.height) * 0.72
        );
        vig.addColorStop(0, 'rgba(0, 0, 0, 0)');
        vig.addColorStop(1, flashlightOn ? 'rgba(4, 6, 12, 0.68)' : 'rgba(4, 6, 12, 0.35)');
        ctx.fillStyle = vig;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
      }

      // --- Главный цикл анимации ---
      function gameLoop(timestamp) {
        if (gameState !== 'playing') return;
        const dt = Math.min(0.05, (timestamp - lastTime) / 1000 || 0.016);
        lastTime = timestamp;

        update(dt);
        render();

        if (gameState === 'playing') {
          animFrameId = requestAnimationFrame(gameLoop);
        }
      }

      function startNewGame() {
        initAudio();
        if (animFrameId) cancelAnimationFrame(animFrameId);
        resetGame();
        gameState = 'playing';
        menuModal.classList.add('hidden');
        btnResumeGame.classList.add('hidden');
        lastTime = performance.now();
        animFrameId = requestAnimationFrame(gameLoop);
      }

      function pauseGame() {
        if (gameState !== 'playing') return;
        gameState = 'paused';
        if (animFrameId) cancelAnimationFrame(animFrameId);
        modalTitle.textContent = 'ПАУЗА';
        modalSubtitle.textContent = 'Передышка в безопасной комнате R.P.D. Проверьте боезапас и возвращайтесь к бою.';
        finalScoreVal.textContent = String(score);
        finalWaveVal.textContent = String(wave);
        finalKillsVal.textContent = String(kills);
        statsSummaryBox.classList.remove('hidden');
        btnStartGame.textContent = 'ЗАНОВО';
        btnResumeGame.classList.remove('hidden');
        menuModal.classList.remove('hidden');
      }

      function resumeGame() {
        if (gameState !== 'paused') return;
        initAudio();
        gameState = 'playing';
        menuModal.classList.add('hidden');
        lastTime = performance.now();
        animFrameId = requestAnimationFrame(gameLoop);
      }

      function triggerGameOver() {
        gameState = 'gameover';
        if (animFrameId) cancelAnimationFrame(animFrameId);
        saveBestScore(score);
        modalTitle.textContent = 'YOU ARE DEAD';
        modalTitle.className = 'text-2xl font-extrabold text-red-500 tracking-widest';
        modalSubtitle.textContent = 'Периметр прорван. Но вы можете начать новую попытку и побить свой рекорд!';
        finalScoreVal.textContent = String(score);
        finalWaveVal.textContent = String(wave);
        finalKillsVal.textContent = String(kills);
        statsSummaryBox.classList.remove('hidden');
        btnStartGame.textContent = 'ИГРАТЬ СНОВА';
        btnResumeGame.classList.add('hidden');
        menuModal.classList.remove('hidden');
      }

      // --- Обработчики клавиатуры и мыши ---
      window.addEventListener('keydown', function (e) {
        keys[e.code] = true;
        if (e.code === 'Digit1') selectWeapon(1);
        else if (e.code === 'Digit2') selectWeapon(2);
        else if (e.code === 'Digit3') selectWeapon(3);
        else if (e.code === 'KeyQ') {
          const next = player.weapon === 3 ? 1 : player.weapon + 1;
          selectWeapon(next);
        } else if (e.code === 'Space') {
          e.preventDefault();
          performDash();
        } else if (e.code === 'KeyF') {
          flashlightOn = !flashlightOn;
        } else if (e.code === 'Escape' || e.code === 'KeyP') {
          if (gameState === 'playing') pauseGame();
          else if (gameState === 'paused') resumeGame();
        }
      });

      window.addEventListener('keyup', function (e) {
        keys[e.code] = false;
      });

      canvas.addEventListener('mousemove', function (e) {
        mouse.x = e.clientX;
        mouse.y = e.clientY;
        mouse.active = true;
      });

      canvas.addEventListener('mousedown', function (e) {
        if (e.button === 0) {
          initAudio();
          mouse.down = true;
          mouse.active = true;
        }
      });

      window.addEventListener('mouseup', function (e) {
        if (e.button === 0) {
          mouse.down = false;
        }
      });

      // --- Обработчики сенсорных джойстиков для Telegram Mini App ---
      function bindJoystick(zoneEl, knobEl, stickState) {
        const maxDist = 36;

        zoneEl.addEventListener('pointerdown', function (e) {
          e.preventDefault();
          initAudio();
          zoneEl.setPointerCapture(e.pointerId);
          const rect = zoneEl.getBoundingClientRect();
          stickState.active = true;
          stickState.id = e.pointerId;
          stickState.startX = rect.left + rect.width / 2;
          stickState.startY = rect.top + rect.height / 2;
          updateStick(e.clientX, e.clientY);
        });

        zoneEl.addEventListener('pointermove', function (e) {
          if (!stickState.active || e.pointerId !== stickState.id) return;
          e.preventDefault();
          updateStick(e.clientX, e.clientY);
        });

        function endStick(e) {
          if (e.pointerId !== stickState.id) return;
          stickState.active = false;
          stickState.id = null;
          stickState.dx = 0;
          stickState.dy = 0;
          knobEl.style.transform = 'translate(0px, 0px)';
        }

        zoneEl.addEventListener('pointerup', endStick);
        zoneEl.addEventListener('pointercancel', endStick);

        function updateStick(clientX, clientY) {
          let vx = clientX - stickState.startX;
          let vy = clientY - stickState.startY;
          const dist = Math.hypot(vx, vy);
          if (dist > maxDist) {
            vx = (vx / dist) * maxDist;
            vy = (vy / dist) * maxDist;
          }
          stickState.dx = vx / maxDist;
          stickState.dy = vy / maxDist;
          knobEl.style.transform = 'translate(' + vx.toFixed(1) + 'px, ' + vy.toFixed(1) + 'px)';
        }
      }

      bindJoystick(leftJoystickZone, leftStickKnob, leftStick);
      bindJoystick(rightJoystickZone, rightStickKnob, rightStick);

      // --- Кнопки UI ---
      btnWep1.addEventListener('click', function () { selectWeapon(1); });
      btnWep2.addEventListener('click', function () { selectWeapon(2); });
      btnWep3.addEventListener('click', function () { selectWeapon(3); });

      btnMute.addEventListener('click', function () {
        soundMuted = !soundMuted;
        muteIcon.textContent = soundMuted ? 'ЗВУК:ВЫКЛ' : 'ЗВУК:ВКЛ';
      });

      btnPause.addEventListener('click', function () {
        if (gameState === 'playing') pauseGame();
        else if (gameState === 'paused') resumeGame();
      });

      btnDash.addEventListener('click', function () {
        performDash();
      });

      btnFlashlight.addEventListener('click', function () {
        flashlightOn = !flashlightOn;
      });

      btnStartGame.addEventListener('click', function () {
        modalTitle.className = 'text-2xl font-extrabold text-white tracking-tight';
        startNewGame();
      });

      btnResumeGame.addEventListener('click', function () {
        resumeGame();
      });

      btnTgHelp.addEventListener('click', function () {
        if (gameState === 'playing') pauseGame();
        tgGuideModal.classList.remove('hidden');
      });

      btnCloseTgGuide.addEventListener('click', function () {
        tgGuideModal.classList.add('hidden');
      });

      btnOkTgGuide.addEventListener('click', function () {
        tgGuideModal.classList.add('hidden');
      });

      // Первичная отрисовка фона до старта
      window.onload = function () {
        resizeCanvas();
        render();
      };
    })();
  </script>
</body>
